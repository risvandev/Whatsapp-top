# ==============================================================================
# HOW TO USE THIS FILE
# ==============================================================================
# 1. Copy this file:
#       Linux/macOS:  cp .env.example .env
#       Windows:      Copy-Item .env.example .env
#
# 2. Open .env and replace placeholder values with your real ones.
# ==============================================================================

# Port the bot server listens on (default: 5001)
PORT=5001

# Secret key used to authenticate requests from the API server.
# ⚠️  MUST match WHATSAPP_BOT_SECRET in the root .env exactly!
WHATSAPP_BOT_SECRET="change-this-to-a-long-random-secret"
