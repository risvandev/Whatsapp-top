# ==============================================================================
# HOW TO USE THIS FILE
# ==============================================================================
# 1. Copy this file to create your own config:
#       Linux/macOS:  cp .env.example .env
#       Windows:      Copy-Item .env.example .env
#
# 2. Open .env and replace the placeholder values with your real ones.
#
# 3. The .env file is gitignored — it will never be committed to git.
#    Only this .env.example template is committed.
# ==============================================================================


# ==============================================================================
# REQUIRED — LOCAL DEVELOPMENT & PRODUCTION
# ==============================================================================

# The URL where your WhatsApp Bot gateway is running.
# For local development this is always http://localhost:5001
# For Vercel production: set this to your deployed bot's public URL
#   e.g. https://my-whatsapp-bot.onrender.com
WHATSAPP_BOT_URL="http://localhost:5001"

# A secret key shared between the API server and the WhatsApp Bot.
# This prevents unauthorized parties from triggering your bot.
# ⚠️  IMPORTANT: Change this to any long random string before deploying!
#   Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_BOT_SECRET="change-this-to-a-long-random-secret"


# ==============================================================================
# OPTIONAL — VERCEL / PRODUCTION ONLY (not needed for local development)
# ==============================================================================
# Upstash Redis is required when running on Vercel because Vercel serverless
# functions are stateless and cannot write files between requests.
#
# For LOCAL development: leave these commented out.
#   The system automatically falls back to a local file cache (.otp-cache.json).
#
# For VERCEL PRODUCTION: uncomment and fill in your values.
#   Get them from: https://console.upstash.com → your Redis DB → REST API tab
#
# KV_REST_API_URL="https://YOUR-DATABASE-ID.upstash.io"
# KV_REST_API_TOKEN="YOUR_UPSTASH_REST_TOKEN_HERE"
